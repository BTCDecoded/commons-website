{
  "schema_version": 1,
  "measured_at": "2026-11-11",
  "internal_slug": "blvm",
  "internal_name": "commons",
  "class": "Bitcoin full-node source trees already compared on this machine, plus Bitcoin Core as the secsov baseline and Knots because that checkout uses Core's src layout. GridPool is outside this class. The 2026-10-01 Commons Pool note is a reward-network request.",
  "tree_methods": [
    {
      "id": "implementation_code",
      "name": "Implementation code",
      "unit": "lines",
      "compare": "same-counter",
      "why": "Size of the program the rules sit in. tokei code lines, one bucket per file."
    },
    {
      "id": "program_code",
      "name": "Program code",
      "unit": "lines",
      "compare": "same-counter",
      "why": "Implementation code minus tooling."
    },
    {
      "id": "tooling_code",
      "name": "Tooling",
      "unit": "lines",
      "compare": "same-counter",
      "why": "Files the role map marks as tooling. Spec lock lives here on commons."
    },
    {
      "id": "rules_share",
      "name": "Rules share",
      "unit": "percent of implementation",
      "compare": "same-profile",
      "why": "Share of implementation on the rules side of that tree's cut. The Core file cut, the crate-role cut, and the repository-role cut are separate instruments."
    },
    {
      "id": "mixed_share",
      "name": "Left mixed",
      "unit": "percent of implementation",
      "compare": "same-profile",
      "why": "Share left in a crate or library the cut did not split."
    },
    {
      "id": "test_per_implementation",
      "name": "Tests per implementation line",
      "unit": "ratio",
      "compare": "same-counter",
      "why": "Test-bucket code lines divided by implementation code lines."
    },
    {
      "id": "vendored_code",
      "name": "Vendored code",
      "unit": "lines",
      "compare": "same-counter",
      "why": "Bundled libraries. Outside first-party code."
    },
    {
      "id": "locale_code",
      "name": "Locale",
      "unit": "lines",
      "compare": "same-counter",
      "why": "Translation files. Outside first-party code."
    },
    {
      "id": "share_lines_ge_1000",
      "name": "Lines in files of 1,000 or more",
      "unit": "percent of implementation files' code",
      "compare": "same-counter",
      "why": "How much of the implementation sits in large files."
    },
    {
      "id": "files_holding_half",
      "name": "Files holding half the implementation",
      "unit": "files",
      "compare": "same-counter",
      "why": "Smallest set of implementation files whose code lines reach half the implementation."
    }
  ],
